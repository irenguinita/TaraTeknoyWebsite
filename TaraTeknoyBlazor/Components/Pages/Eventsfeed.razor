@page "/events"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="events-page">

    <!-- ===================== FIXED HEADER ===================== -->
    <header class="events-header">
        <div class="events-header__row">
            <img class="events-header__logo" src="images/logo.png" alt="Tara Teknoy" />

            <div class="events-header__actions">
                <button class="icon-btn" type="button" @onclick="OnSearchClicked" aria-label="Search">
                    <img src="images/search-icon.png" alt="" />
                </button>
                <button class="icon-btn" type="button" @onclick="OnProfileClicked" aria-label="Profile">
                    <img src="images/profile-icon.png" alt="" />
                </button>
            </div>
        </div>
        <div class="events-header__rule"></div>
    </header>

    <!-- ===================== SCROLLABLE CONTENT ===================== -->
    <main class="events-content">

        <!-- ---------- Happening Now (horizontal scroll) ---------- -->
        <section class="section">
            <h2 class="section__title">Happening Now</h2>

            <div class="hscroll">
                @foreach (var ev in HappeningNow)
                {
                    <article class="event-card" @onclick="GoToEventDetails">
                        <div class="event-card__top">
                            <span class="pill pill--time">@ev.TimeRange</span>
                            <span class="pill pill--category">@ev.Category</span>
                        </div>

                        <h3 class="event-card__title">@ev.Title</h3>
                        <p class="event-card__org">
                            @ev.OrganizationName
                            <span class="verified-dot" title="Verified organizer"></span>
                        </p>

                        <div class="event-card__image"></div>

                        <div class="event-card__meta">
                            <span class="meta-item">
                                <span class="meta-icon meta-icon--pin"></span>
                                @ev.Location
                            </span>
                            <span class="status status--@ev.StatusModifier">
                                <span class="status__dot"></span>
                                @ev.StatusLabel
                            </span>
                        </div>

                        <div class="event-card__bottom">
                            <span class="meta-item">
                                <span class="meta-icon meta-icon--people"></span>
                                @ev.Attendees/@ev.Capacity
                            </span>
                            <button class="rsvp-btn" type="button" @onclick="() => OnRsvpClicked(ev)" @onclick:stopPropagation>RSVP</button>
                        </div>
                    </article>
                }
            </div>
        </section>

        <!-- ---------- Recommended For You ---------- -->
        <section class="section">
            <h2 class="section__title">Recommended For You</h2>

            <div class="recommended-grid">
                @foreach (var ev in Recommended)
                {
                    <article class="rec-card" @onclick="GoToEventDetails">
                        <div class="rec-card__image"></div>

                        <div class="rec-card__body">
                            <p class="rec-card__reason">Based on your interest in @ev.InterestTag</p>
                            <h3 class="rec-card__title">@ev.Title</h3>
                            <p class="rec-card__org">
                                @ev.OrganizationName
                                <span class="verified-dot" title="Verified organizer"></span>
                            </p>
                            <p class="rec-card__date">@ev.Date, @ev.TimeRange</p>

                            <div class="rec-card__tags">
                                @foreach (var category in ev.Categories)
                                {
                                    <span class="pill pill--category">@category</span>
                                }
                            </div>

                            <span class="meta-item">
                                <span class="meta-icon meta-icon--pin"></span>
                                @ev.Location
                            </span>
                        </div>
                    </article>
                }
            </div>
        </section>

    </main>
</div>

@code {
    private List<EventCardModel> HappeningNow { get; set; } = new();
    private List<RecommendedEventModel> Recommended { get; set; } = new();

    protected override void OnInitialized()
    {
        // TODO: replace with data loaded from your API / service layer.
        HappeningNow = new List<EventCardModel>
        {
            new("Event Title", "Organization Name", "00:00 A.M. - 00:00 A.M.", "Category",
                "Location", 45, 60, "Live", "live"),
            new("Event Title", "Organization Name", "00:00 A.M. - 00:00 A.M.", "Category",
                "Location", 45, 60, "Starts in 2 hours", "upcoming"),
            new("Event Title", "Organization Name", "00:00 A.M. - 00:00 A.M.", "Category",
                "Location", 45, 60, "Live", "live"),
            new("Event Title", "Organization Name", "00:00 A.M. - 00:00 A.M.", "Category",
                "Location", 45, 60, "Live", "live"),
        };

        Recommended = new List<RecommendedEventModel>
        {
            new("Event Title", "Organization Name", "Month, Day, Year", "00:00 A.M. - 00:00 A.M.",
                "Location", "X", new List<string> { "Category", "Category" }),
            new("Event Title", "Organization Name", "Month, Day, Year", "00:00 A.M. - 00:00 A.M.",
                "Location", "X", new List<string> { "Category", "Category" }),
        };
    }

    private void OnSearchClicked()
    {
        // TODO: open search
    }

    private void OnProfileClicked()
    {
        // TODO: navigate to profile
    }

    private void OnRsvpClicked(EventCardModel ev)
    {
        // TODO: handle RSVP
    }

    private void GoToEventDetails()
    {
        // Hardcoded for now — swap in the real event id once details are wired to data.
        Nav.NavigateTo("/events/1");
    }

    public record EventCardModel(
        string Title,
        string OrganizationName,
        string TimeRange,
        string Category,
        string Location,
        int Attendees,
        int Capacity,
        string StatusLabel,
        string StatusModifier);

    public record RecommendedEventModel(
        string Title,
        string OrganizationName,
        string Date,
        string TimeRange,
        string Location,
        string InterestTag,
        List<string> Categories);
}
