@page "/events/{EventId:int}"
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer

<div class="flex min-h-screen w-full flex-col bg-white font-sans text-[#1F1F1F]">

    <!-- ===================== FIXED HEADER ===================== -->
    <header class="sticky top-0 z-20 flex-none bg-white px-4 pt-4 shadow-sm sm:px-8 sm:pt-5">
        <div class="mx-auto flex max-w-7xl items-center justify-between">
            <img class="block h-10 w-auto sm:h-[52px]" src="/images/logo2.png" alt="Tara Teknoy" />

            <div class="flex items-center gap-4 sm:gap-5">
                <button class="inline-flex cursor-pointer items-center justify-center border-none bg-transparent p-1"
                        type="button" @onclick="OnSearchClicked" aria-label="Search">
                    <img class="block h-6 w-6 sm:h-[26px] sm:w-[26px]" src="/images/search.png" alt="Search" />
                </button>
                <button class="inline-flex cursor-pointer items-center justify-center border-none bg-transparent p-1"
                        type="button" @onclick="OnProfileClicked" aria-label="Profile">
                    <img class="block h-6 w-6 sm:h-[26px] sm:w-[26px]" src="/images/profile.png" alt="Profile" />
                </button>
            </div>
        </div>
        <div class="mt-3 h-[3px] w-full bg-[#F4C10F] sm:mt-4"></div>
    </header>

    <!-- ===================== MAIN CONTENT AREA ===================== -->
    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-6 pb-28 sm:px-8 sm:py-7">

        <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-12">

            <!-- ---------- Left Column (Meta & Actions) ---------- -->
            <div class="min-w-0 md:col-span-5 lg:col-span-4">
                <!-- Image Placeholder -->
                <div class="mb-5 aspect-[4/3] w-full rounded-lg bg-[#B3B3B3] shadow-inner"></div>

                <!-- Info List -->
                <div class="divide-y divide-[#E9E9E9]">
                    <!-- Date & Time -->
                    <div class="flex items-center gap-3.5 py-3">
                        <span class="h-[26px] w-[26px] flex-none text-[#7A1E2B]">
                            <svg class="h-full w-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                <rect x="3" y="5" width="18" height="16" rx="2" />
                                <line x1="3" y1="10" x2="21" y2="10" />
                                <line x1="8" y1="3" x2="8" y2="7" />
                                <line x1="16" y1="3" x2="16" y2="7" />
                            </svg>
                        </span>
                        <div class="min-w-0 flex-1">
                            <p class="m-0 truncate text-base font-bold">@Event.DateLabel</p>
                            <p class="m-0 mt-0.5 truncate text-sm text-[#4A4A4A]">@Event.TimeRange</p>
                        </div>
                        <button class="h-6 w-6 flex-none cursor-pointer border-none bg-transparent p-0 text-[#1F1F1F] hover:opacity-75"
                                type="button" @onclick="OnAddToCalendar" aria-label="Add to calendar">
                            <svg class="h-full w-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                <rect x="3" y="5" width="18" height="16" rx="2" />
                                <line x1="3" y1="10" x2="21" y2="10" />
                                <line x1="12" y1="13" x2="12" y2="18" />
                                <line x1="9.5" y1="15.5" x2="14.5" y2="15.5" />
                            </svg>
                        </button>
                    </div>

                    <!-- Building & Room -->
                    <div class="flex items-center gap-3.5 py-3">
                        <span class="h-[26px] w-[26px] flex-none text-[#7A1E2B]">
                            <svg class="h-full w-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                <path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" />
                                <circle cx="12" cy="9.5" r="2.3" />
                            </svg>
                        </span>
                        <div class="min-w-0 flex-1">
                            <p class="m-0 truncate text-base font-bold">@Event.Building</p>
                            <p class="m-0 mt-0.5 truncate text-sm text-[#4A4A4A]">@Event.Room</p>
                        </div>
                        <button class="h-6 w-6 flex-none cursor-pointer border-none bg-transparent p-0 text-[#1F1F1F] hover:opacity-75"
                                type="button" @onclick="OnGetDirections" aria-label="Get directions">
                            <svg class="h-full w-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                <path d="M3 11l17-8-8 17-2.5-6.5L3 11Z" stroke-linejoin="round" />
                            </svg>
                        </button>
                    </div>

                    <!-- Attendees -->
                    <div class="flex items-center gap-3.5 py-3">
                        <span class="h-[26px] w-[26px] flex-none text-[#7A1E2B]">
                            <svg class="h-full w-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                <circle cx="9" cy="9" r="3" />
                                <path d="M4 19c0-3 2.2-5 5-5s5 2 5 5" />
                                <circle cx="17" cy="10" r="2.4" />
                                <path d="M15.5 14.2c2.1.4 3.5 2 3.5 4.8" />
                            </svg>
                        </span>
                        <div class="min-w-0 flex-1">
                            <p class="m-0 text-base font-bold">Attendees</p>
                            <p class="m-0 mt-0.5 text-sm text-[#4A4A4A]">@Event.Attendees/@Event.Capacity</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ---------- Right Column (Details & Description) ---------- -->
            <div class="min-w-0 md:col-span-7 lg:col-span-8">
                <h1 class="m-0 mb-2 text-3xl leading-tight font-extrabold sm:text-4xl">@Event.Title</h1>
                <p class="m-0 mb-6 flex items-center gap-2 text-base font-semibold text-[#7A1E2B] sm:text-lg">
                    @Event.OrganizationName
                    <span class="inline-flex h-[18px] w-[18px] text-[#F4C10F]" title="Verified organizer">
                        <svg class="h-full w-full" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2l2.2 2.1 3-.6.6 3 2.1 2.2-1.4 2.8 1.4 2.8-2.1 2.2-.6 3-3-.6L12 22l-2.2-2.1-3 .6-.6-3-2.1-2.2 1.4-2.8L4.1 9.7l2.1-2.2.6-3 3 .6L12 2Z" />
                        </svg>
                    </span>
                </p>

                <div class="space-y-4">
                    @foreach (var paragraph in Event.DescriptionParagraphs)
                    {
                        <p class="m-0 text-sm leading-relaxed text-gray-700 sm:text-base">@paragraph</p>
                    }
                </div>
            </div>

        </div>
    </main>

    <!-- ===================== FIXED FOOTER / RSVP BAR ===================== -->
    <footer class="fixed right-0 bottom-0 left-0 z-30 flex items-center justify-between bg-[#F4C10F] px-6 py-4 shadow-lg sm:px-10">
        <span class="text-lg font-extrabold text-[#7A1E2B] sm:text-[22px]">Tara, Teknoy!</span>
        <button class="cursor-pointer rounded-lg border-none bg-[#7A1E2B] px-8 py-2.5 text-base font-bold text-white transition-colors hover:bg-[#5C1620] sm:px-10 sm:py-3 sm:text-[17px]"
                type="button" @onclick="OnRsvpClicked">
            RSVP
        </button>
    </footer>

</div>

@code {
    [Parameter]
    public int EventId { get; set; }

    private EventDetailsModel Event { get; set; } = EventDetailsModel.Placeholder;

    protected override void OnInitialized()
    {
        Event = EventDetailsModel.Placeholder;
    }

    private void OnSearchClicked() { }
    private void OnProfileClicked() { }
    private void OnAddToCalendar() { }
    private void OnGetDirections() { }
    private void OnRsvpClicked() { }

    public class EventDetailsModel
    {
        public string Title { get; set; } = "";
        public string OrganizationName { get; set; } = "";
        public string DateLabel { get; set; } = "";
        public string TimeRange { get; set; } = "";
        public string Building { get; set; } = "";
        public string Room { get; set; } = "";
        public int Attendees { get; set; }
        public int Capacity { get; set; }
        public List<string> DescriptionParagraphs { get; set; } = new();

        public static EventDetailsModel Placeholder => new()
        {
            Title = "Event Title",
            OrganizationName = "Organization Name",
            DateLabel = "Saturday, Day Month Year",
            TimeRange = "00:00 A.M. - 00:00 P.M.",
            Building = "GLE BLDG",
            Room = "Room 201",
            Attendees = 45,
            Capacity = 60,
            DescriptionParagraphs = new List<string>
            {
                "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
                "Etiam rhoncus sem dui, id faucibus nisl maximus porttitor. Donec varius, neque id finibus lobortis, felis ex egestas ante, id sollicitudin arcu ante id nunc. Donec tristique urna nec suscipit pellentesque.",
                "Curabitur fringilla consectetur porttitor. Quisque vitae nunc pulvinar, sagittis felis sit amet, interdum neque. Aliquam suscipit quam luctus, condimentum diam id, euismod leo. Phasellus tincidunt, purus vel pulvinar porta, ipsum sapien cursus ligula, vitae ultricies turpis lorem efficitur felis. Proin sed justo diam. Curabitur nibh tellus, rutrum vitae dictum vel, facilisis vehicula ipsum."
            }
        };
    }
}