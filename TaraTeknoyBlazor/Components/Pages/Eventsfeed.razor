@page "/events"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="flex h-screen flex-col bg-white font-sans text-[#1F1F1F]">

    <!-- ===================== FIXED HEADER ===================== -->
    <header class="sticky top-0 z-10 flex-none bg-white px-6 pt-4">
        <div class="flex items-center justify-between">
            <img class="block h-12 w-auto" src="images/logo2.png" alt="Tara Teknoy" />

            <div class="flex items-center gap-4">
                <button class="inline-flex cursor-pointer items-center justify-center border-none bg-transparent p-1"
                        type="button" @onclick="OnSearchClicked" aria-label="Search">
                    <img class="block h-6 w-6" src="images/search-icon.png" alt="" />
                </button>
                <button class="inline-flex cursor-pointer items-center justify-center border-none bg-transparent p-1"
                        type="button" @onclick="OnProfileClicked" aria-label="Profile">
                    <img class="block h-6 w-6" src="images/profile-icon.png" alt="" />
                </button>
            </div>
        </div>
        <div class="mt-3.5 h-[3px] bg-[#F4C10F]"></div>
    </header>

    <!-- ===================== SCROLLABLE CONTENT ===================== -->
    <main class="flex-1 overflow-y-auto px-6 pt-5 pb-10">

        <!-- ---------- Happening Now (horizontal scroll) ---------- -->
        <section class="mb-8">
            <h2 class="mb-3.5 text-xl font-bold text-[#7A1E2B]">Happening Now</h2>

            <div class="flex gap-4 overflow-x-auto overflow-y-hidden pb-2 [-webkit-overflow-scrolling:touch] [scroll-snap-type:x_proximity]">
                @foreach (var ev in HappeningNow)
                {
                    <article class="flex w-[220px] flex-none cursor-pointer flex-col gap-2 rounded-[10px] border border-[#E9E9E9] p-3 [scroll-snap-align:start]"
                             @onclick="GoToEventDetails">
                        <div class="flex items-center justify-between gap-2">
                            <span class="inline-flex items-center rounded-full py-[3px] pl-0 font-semibold whitespace-nowrap text-[11px] text-[#7A1E2B]">@ev.TimeRange</span>
                            <span class="inline-flex items-center rounded-full bg-[#F4C10F] px-2.5 py-[3px] font-semibold whitespace-nowrap text-[11px] text-[#1F1F1F]">@ev.Category</span>
                        </div>

                        <h3 class="m-0 font-bold text-[17px]">@ev.Title</h3>
                        <p class="m-0 flex items-center gap-1.5 text-[13px]">
                            @ev.OrganizationName
                            <span class="inline-block h-2 w-2 rounded-full bg-[#2F5DE0]" title="Verified organizer"></span>
                        </p>

                        <div class="h-[100px] rounded-md bg-[#D9D9D9]"></div>

                        <div class="flex items-center justify-between text-xs">
                            <span class="inline-flex items-center gap-1">
                                <span class="inline-block h-3 w-3 bg-[#7A1E2B] [border-radius:50%_50%_50%_0]"></span>
                                @ev.Location
                            </span>
                            <span class="inline-flex items-center gap-1 font-semibold @(ev.StatusModifier == "live" ? "text-[#2E9E4C]" : "text-[#2F5DE0]")">
                                <span class="inline-block h-1.5 w-1.5 rounded-full bg-current"></span>
                                @ev.StatusLabel
                            </span>
                        </div>

                        <div class="flex items-center justify-between">
                            <span class="inline-flex items-center gap-1">
                                <span class="inline-block h-3 w-3 rounded-sm bg-[#7A1E2B]"></span>
                                @ev.Attendees/@ev.Capacity
                            </span>
                            <button class="cursor-pointer rounded-md border-none bg-[#7A1E2B] px-[18px] py-1.5 font-bold text-[13px] text-white transition-colors hover:bg-[#5C1620]"
                                    type="button" @onclick="() => OnRsvpClicked(ev)" @onclick:stopPropagation>
                                RSVP
                            </button>
                        </div>
                    </article>
                }
            </div>
        </section>

        <!-- ---------- Recommended For You ---------- -->
        <section class="mb-8">
            <h2 class="mb-3.5 text-xl font-bold text-[#7A1E2B]">Recommended For You</h2>

            <div class="grid grid-cols-[repeat(auto-fill,minmax(320px,1fr))] gap-4">
                @foreach (var ev in Recommended)
                {
                    <article class="flex cursor-pointer gap-3.5 rounded-[10px] border border-[#E9E9E9] p-3" @onclick="GoToEventDetails">
                        <div class="w-[120px] flex-none self-stretch rounded-md bg-[#D9D9D9]"></div>

                        <div class="flex min-w-0 flex-col gap-1">
                            <p class="m-0 text-xs text-[#7A1E2B] italic">Based on your interest in @ev.InterestTag</p>
                            <h3 class="m-0 text-lg font-bold">@ev.Title</h3>
                            <p class="m-0 flex items-center gap-1.5 text-[13px]">
                                @ev.OrganizationName
                                <span class="inline-block h-2 w-2 rounded-full bg-[#2F5DE0]" title="Verified organizer"></span>
                            </p>
                            <p class="mt-0.5 mb-1 text-xs text-[#6B6B6B]">@ev.Date, @ev.TimeRange</p>

                            <div class="mb-1 flex gap-1.5">
                                @foreach (var category in ev.Categories)
                                {
                                    <span class="inline-flex items-center rounded-full bg-[#F4C10F] px-2.5 py-[3px] font-semibold whitespace-nowrap text-[11px] text-[#1F1F1F]">@category</span>
                                }
                            </div>

                            <span class="inline-flex items-center gap-1">
                                <span class="inline-block h-3 w-3 bg-[#7A1E2B] [border-radius:50%_50%_50%_0]"></span>
                                @ev.Location
                            </span>
                        </div>
                    </article>
                }
            </div>
        </section>

    </main>
</div>

