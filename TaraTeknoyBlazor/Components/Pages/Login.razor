@page "/"
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager NavManager

<div class="fixed inset-0 z-[1000] flex min-h-screen w-screen items-center justify-center overflow-y-auto bg-[#801A1A] p-4">
    <div class="w-full max-w-[380px] rounded-2xl border border-white/10 bg-[#801A1A] p-6 text-center text-white shadow-2xl">

        <!-- Branding Image -->
        <div class="mx-auto mb-6 max-w-[220px] transition-transform hover:scale-105">
            <img src="/images/logo_tarateknoy.png" class="block h-auto w-full drop-shadow-md" alt="Tara Teknoy Logo" />
        </div>

        <!-- Form Elements -->
        <div class="my-6 space-y-4">
            <div>
                <input @bind="email" type="email" placeholder="University Email (.edu)"
                       class="w-full rounded-xl border-none bg-white px-4 py-3.5 text-sm text-gray-800 placeholder-gray-400 transition-all outline-none focus:ring-2 focus:ring-[#F4C10F]" />
            </div>

            <div>
                <input @bind="password" type="password" placeholder="Password"
                       class="w-full rounded-xl border-none bg-white px-4 py-3.5 text-sm text-gray-800 placeholder-gray-400 transition-all outline-none focus:ring-2 focus:ring-[#F4C10F]" />
            </div>

            <button @onclick="HandleLogin" disabled="@isLoading"
                    class="flex w-full items-center justify-center rounded-xl border-none bg-[#F4C10F] px-4 py-3.5 text-base font-bold text-[#801A1A] shadow-md transition-all hover:bg-[#e0b027] active:scale-95 disabled:opacity-70">
                @if (isLoading)
                {
                    <span class="animate-pulse">Logging in...</span>
                }
                else
                {
                    <span>Log in</span>
                }
            </button>
        </div>

        <!-- Error Display -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mt-3 rounded-xl border border-red-500/30 bg-red-500/20 p-3 text-xs font-medium text-red-100">
                @errorMessage
            </div>
        }

        <!-- Bottom Link -->
        <div class="mt-8 text-xs text-gray-200">
            Don’t have an account?
            <a href="/signup" class="ml-1 font-bold text-[#F4C10F] hover:underline">Create an account</a>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        errorMessage = "";

        // Hardcoded validation checks
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter both your email and password.";
            return;
        }

        if (!email.EndsWith(".edu") && !email.Contains("@"))
        {
            errorMessage = "Please enter a valid university email address (.edu).";
            return;
        }

        NavManager.NavigateTo("/events");
    }
}