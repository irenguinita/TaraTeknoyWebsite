@page "/"
@inject NavigationManager NavManager

<div class="login-container d-flex align-items-center justify-content-center">
    <div class="login-card text-center text-white">

        <!-- Tara Teknoy Branding Image -->
        <div class="logo-container mb-4 text-center">
            @* <img src="logo_tarateknoy.png" class="brand-logo-img" /> *@
            <!-- In Login.razor -->
            <img src="@Assets["images/logo_tarateknoy.png"]" class="brand-logo-img" alt="Tara Teknoy Logo" />
        </div>

        <!-- Form Elements -->
        <div class="form-group my-4">
            <input @bind="email" type="email" placeholder="University Email (.edu)" class="form-input" />

            <input @bind="password" type="password" placeholder="Password" class="form-input mt-3" />

            <button @onclick="HandleLogin" class="btn btn-login mt-3 w-100">Log in</button>
        </div>

        <!-- Optional Error Display -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 mt-2" style="font-size: 0.9rem;">
                @errorMessage
            </div>
        }

        <!-- Bottom Link -->
        <div class="signup-link mt-4">
            Don’t have an account? <a href="/signup">Create an account</a>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string errorMessage = "";

    private void HandleLogin()
    {
        
            // SUCCESS: Navigates to the events page
        NavManager.NavigateTo("/events");
        
    }
}

<style>
    /* Scoped Style Overrides for custom Maroon/Gold UI */
    .login-container {
        background-color: #801A1A; /* Maroon Base */
        min-height: 100vh;
        width: 100vw;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1000;
        overflow-y: auto;
    }

    .login-card {
        max-width: 400px;
        width: 100%;
        padding: 20px;
    }

    .logo-container {
        max-width: 280px; /* Adjust width to fit your layout */
        margin: 0 auto;
    }

    .brand-logo-img {
        width: 100%;
        height: auto;
        display: block;
    }

    .location-pin {
        font-size: 3rem;
        display: block;
        color: #F7C631; /* Gold */
    }

    .brand-subtitle {
        font-size: 0.95rem;
        opacity: 0.85;
    }

    .form-input {
        background: white;
        border: none;
        border-radius: 8px;
        padding: 12px 16px;
        width: 100%;
        color: #333;
        font-size: 1rem;
    }

    .form-input::placeholder {
        color: #999;
    }

    .btn-login {
        background-color: #F7C631; /* Gold Button */
        color: #801A1A !important;
        font-weight: bold;
        border-radius: 8px;
        padding: 12px;
        font-size: 1.1rem;
        border: none;
    }

    .btn-login:hover {
        background-color: #e0b027;
    }

    .signup-link {
        font-size: 0.85rem;
        color: #eee;
    }

    .signup-link a {
        color: #F7C631;
        font-weight: bold;
        text-decoration: none;
    }

    .signup-link a:hover {
        text-decoration: underline;
    }
</style>