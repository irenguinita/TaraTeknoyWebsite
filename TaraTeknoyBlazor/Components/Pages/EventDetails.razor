@page "/events/{EventId:int}"
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer

<div class="relative min-h-screen w-full bg-white pb-20 text-gray-900">

    <!-- ===================== FIXED HEADER ===================== -->
    <header class="fixed top-0 right-0 left-0 z-50 bg-white shadow-sm">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
            <div class="flex items-center">
                <img class="h-10 w-auto object-contain" src="images/logo2.png" alt="Tara Teknoy" />
            </div>

            <div class="flex items-center gap-3">
                <button class="rounded-full p-2 text-[#E2AC22] transition-colors hover:bg-gray-100 focus:outline-none"
                        type="button"
                        @onclick="OnSearchClicked"
                        aria-label="Search">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>

                <button class="rounded-full p-1 text-[#E2AC22] transition-colors hover:bg-gray-100 focus:outline-none"
                        type="button"
                        @onclick="OnProfileClicked"
                        aria-label="Profile">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" />
                    </svg>
                </button>
            </div>
        </div>
        <div class="h-[2px] w-full bg-[#8B1E22]"></div>
    </header>

    <!-- ===================== SCROLLABLE CONTENT ===================== -->
    <main class="mx-auto max-w-7xl px-4 pt-24 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">

            <!-- ---------- Left Column ---------- -->
            <div class="flex flex-col gap-6 lg:col-span-5">
                <!-- Hero Placeholder -->
                <div class="aspect-video w-full rounded-2xl bg-gray-300 shadow-inner"></div>

                <!-- Info Card Container -->
                <div class="divide-y divide-gray-200 rounded-2xl border border-gray-100 bg-gray-50 p-4 shadow-sm">

                    <!-- Date & Time Row -->
                    <div class="flex items-center justify-between py-3">
                        <div class="flex items-center gap-3">
                            <span class="flex items-center justify-center text-[#8B1E22]">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                    <line x1="7" y1="14" x2="9" y2="14"></line>
                                    <line x1="11" y1="14" x2="13" y2="14"></line>
                                    <line x1="15" y1="14" x2="17" y2="14"></line>
                                </svg>
                            </span>
                            <div>
                                <p class="text-sm font-semibold text-gray-900">@Event.DateLabel</p>
                                <p class="text-xs text-gray-500">@Event.TimeRange</p>
                            </div>
                        </div>
                        <button class="rounded-lg p-2 text-gray-700 transition-colors hover:bg-gray-200 focus:outline-none"
                                type="button"
                                @onclick="OnAddToCalendar"
                                aria-label="Add to calendar">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                                <line x1="12" y1="13" x2="12" y2="19"></line>
                                <line x1="9" y1="16" x2="15" y2="16"></line>
                            </svg>
                        </button>
                    </div>

                    <!-- Location Row -->
                    <div class="flex items-center justify-between py-3">
                        <div class="flex items-center gap-3">
                            <span class="flex items-center justify-center text-[#8B1E22]">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                            </span>
                            <div>
                                <p class="text-sm font-semibold text-gray-900">@Event.Building</p>
                                <p class="text-xs text-gray-500">@Event.Room</p>
                            </div>
                        </div>
                        <button class="rounded-lg p-2 text-gray-700 transition-colors hover:bg-gray-200 focus:outline-none"
                                type="button"
                                @onclick="OnGetDirections"
                                aria-label="Get directions">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                                <path d="M12 22l8-5"></path>
                            </svg>
                        </button>
                    </div>

                    <!-- Attendees Row -->
                    <div class="flex items-center justify-between py-3">
                        <div class="flex items-center gap-3">
                            <span class="flex items-center justify-center text-[#8B1E22]">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </span>
                            <div>
                                <p class="text-sm font-semibold text-gray-900">Attendees</p>
                                <p class="text-xs text-gray-500">@Event.Attendees/@Event.Capacity</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ---------- Right Column ---------- -->
            <div class="flex flex-col lg:col-span-7">
                <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">@Event.Title</h1>

                <div class="mt-2 flex items-center gap-2">
                    <span class="text-base font-semibold text-[#8B1E22]">@Event.OrganizationName</span>
                    <span title="Verified organizer" class="inline-flex items-center">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="#8B1E22">
                            <path d="M12 2l2.4 2.1 3.2-.5.5 3.2 2.7 1.8-1.3 3 1.3 3-2.7 1.8-.5 3.2-3.2-.5L12 22l-2.4-2.1-3.2.5-.5-3.2-2.7-1.8 1.3-3-1.3-3 2.7-1.8.5-3.2 3.2.5L12 2z" />
                            <path d="M9.5 12l2 2 4.5-4.5" stroke="#FFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                        </svg>
                    </span>
                </div>

                <div class="mt-6 space-y-4">
                    @foreach (var paragraph in Event.DescriptionParagraphs)
                    {
                        <p class="text-base leading-relaxed text-gray-600">@paragraph</p>
                    }
                </div>
            </div>

        </div>
    </main>

    <!-- ===================== FIXED FOOTER / RSVP BAR ===================== -->
    <footer class="fixed right-0 bottom-0 left-0 z-40 bg-[#8B1E22] px-6 py-4 shadow-lg">
        <div class="mx-auto flex max-w-7xl items-center justify-between">
            <span class="text-lg font-bold text-white sm:text-xl">Tara, Teknoy!</span>
            <button class="rounded-xl bg-[#E2AC22] px-6 py-2.5 text-base font-bold text-[#8B1E22] shadow transition-all hover:bg-[#d49f1b] active:scale-95"
                    type="button"
                    @onclick="OnRsvpClicked">
                RSVP
            </button>
        </div>
    </footer>

</div>

@code {
    [Parameter]
    public int EventId { get; set; }

    private EventDetailsModel Event { get; set; } = EventDetailsModel.Placeholder;

    protected override void OnInitialized()
    {
        Event = EventDetailsModel.Placeholder;
    }

    private void OnSearchClicked() { /* TODO: open search */ }
    private void OnProfileClicked() { /* TODO: navigate to profile */ }
    private void OnAddToCalendar() { /* TODO: add event to calendar */ }
    private void OnGetDirections() { /* TODO: open directions */ }
    private void OnRsvpClicked() { /* TODO: handle RSVP */ }

    public class EventDetailsModel
    {
        public string Title { get; set; } = "";
        public string OrganizationName { get; set; } = "";
        public string DateLabel { get; set; } = "";
        public string TimeRange { get; set; } = "";
        public string Building { get; set; } = "";
        public string Room { get; set; } = "";
        public int Attendees { get; set; }
        public int Capacity { get; set; }
        public List<string> DescriptionParagraphs { get; set; } = new();

        public static EventDetailsModel Placeholder => new()
        {
            Title = "Event Title",
            OrganizationName = "Organization Name",
            DateLabel = "Saturday, Day Month Year",
            TimeRange = "00:00 A.M. - 00:00 P.M.",
            Building = "GLE BLDG",
            Room = "Room 201",
            Attendees = 45,
            Capacity = 60,
            DescriptionParagraphs = new List<string>
            {
                "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
                "Etiam rhoncus sem dui, id faucibus nisl maximus porttitor. Donec varius, neque id finibus lobortis, felis ex egestas ante, id sollicitudin arcu ante id nunc. Donec tristique urna nec suscipit pellentesque.",
                "Curabitur fringilla consectetur porttitor. Quisque vitae nunc pulvinar, sagittis felis sit amet, interdum neque. Aliquam suscipit quam luctus, condimentum diam id, euismod leo. Phasellus tincidunt, purus vel pulvinar porta, ipsum sapien cursus ligula, vitae ultricies turpis lorem efficitur felis. Proin sed justo diam. Curabitur nibh tellus, rutrum vitae dictum vel, facilisis vehicula ipsum."
            }
        };
    }
}