@page "/events/{EventId:int}"

<div class="event-details-page">

    <!-- ===================== FIXED HEADER ===================== -->
    <header class="event-details-header">
        <div class="event-details-header__row">
            <div class="event-details-header__logo-container">
                <img class="event-details-header__logo" src="images/logo2.png" alt="Tara Teknoy" />
            </div>

            <div class="event-details-header__actions">
                <button class="icon-btn" type="button" @onclick="OnSearchClicked" aria-label="Search">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E2AC22" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
                <button class="icon-btn" type="button" @onclick="OnProfileClicked" aria-label="Profile">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="#E2AC22">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" />
                    </svg>
                </button>
            </div>
        </div>
        <div class="event-details-header__rule"></div>
    </header>

    <!-- ===================== SCROLLABLE CONTENT ===================== -->
    <main class="event-details-content">

        <div class="event-details-grid">

            <!-- ---------- Left column ---------- -->
            <div class="event-details-left">
                <!-- Gray Placeholder Hero Rectangle -->
                <div class="event-hero-placeholder"></div>

                <!-- Info Row: Date & Time -->
                <div class="info-row">
                    <div class="info-row__left">
                        <span class="info-row__icon">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8B1E22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                                <line x1="7" y1="14" x2="9" y2="14"></line>
                                <line x1="11" y1="14" x2="13" y2="14"></line>
                                <line x1="15" y1="14" x2="17" y2="14"></line>
                            </svg>
                        </span>
                        <div class="info-row__text">
                            <p class="info-row__primary">@Event.DateLabel</p>
                            <p class="info-row__secondary">@Event.TimeRange</p>
                        </div>
                    </div>
                    <button class="icon-btn-action" type="button" @onclick="OnAddToCalendar" aria-label="Add to calendar">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                            <line x1="12" y1="13" x2="12" y2="19"></line>
                            <line x1="9" y1="16" x2="15" y2="16"></line>
                        </svg>
                    </button>
                </div>

                <!-- Info Row: Location -->
                <div class="info-row">
                    <div class="info-row__left">
                        <span class="info-row__icon">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8B1E22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </span>
                        <div class="info-row__text">
                            <p class="info-row__primary">@Event.Building</p>
                            <p class="info-row__secondary">@Event.Room</p>
                        </div>
                    </div>
                    <button class="icon-btn-action" type="button" @onclick="OnGetDirections" aria-label="Get directions">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                            <path d="M12 22l8-5"></path>
                        </svg>
                    </button>
                </div>

                <!-- Info Row: Attendees -->
                <div class="info-row info-row--last">
                    <div class="info-row__left">
                        <span class="info-row__icon">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8B1E22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </span>
                        <div class="info-row__text">
                            <p class="info-row__primary">Attendees</p>
                            <p class="info-row__secondary">@Event.Attendees/@Event.Capacity</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ---------- Right column ---------- -->
            <div class="event-details-right">
                <h1 class="event-title">@Event.Title</h1>

                <div class="event-org-row">
                    <span class="event-org">@Event.OrganizationName</span>
                    <span class="verified-badge" title="Verified organizer">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="#8B1E22">
                            <path d="M12 2l2.4 2.1 3.2-.5.5 3.2 2.7 1.8-1.3 3 1.3 3-2.7 1.8-.5 3.2-3.2-.5L12 22l-2.4-2.1-3.2.5-.5-3.2-2.7-1.8 1.3-3-1.3-3 2.7-1.8.5-3.2 3.2.5L12 2z" />
                            <path d="M9.5 12l2 2 4.5-4.5" stroke="#FFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                        </svg>
                    </span>
                </div>

                @foreach (var paragraph in Event.DescriptionParagraphs)
                {
                    <p class="event-description">@paragraph</p>
                }
            </div>

        </div>
    </main>

    <!-- ===================== FIXED FOOTER / RSVP BAR ===================== -->
    <footer class="rsvp-bar">
        <span class="rsvp-bar__greeting">Tara, Teknoy!</span>
        <button class="rsvp-bar__button" type="button" @onclick="OnRsvpClicked">RSVP</button>
    </footer>

</div>

@code {
    [Parameter]
    public int EventId { get; set; }

    private EventDetailsModel Event { get; set; } = EventDetailsModel.Placeholder;

    protected override void OnInitialized()
    {
        // TODO: load the real event using EventId from your API / service layer.
        Event = EventDetailsModel.Placeholder;
    }

    private void OnSearchClicked() { /* TODO: open search */ }
    private void OnProfileClicked() { /* TODO: navigate to profile */ }
    private void OnAddToCalendar() { /* TODO: add event to calendar */ }
    private void OnGetDirections() { /* TODO: open directions */ }
