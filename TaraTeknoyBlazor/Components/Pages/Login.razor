@page "/"
@inject NavigationManager NavManager

<div class="fixed inset-0 z-[1000] flex min-h-screen w-screen items-center justify-center overflow-y-auto bg-[#801A1A]">
    <div class="w-full max-w-[400px] p-5 text-center text-white">

        <!-- Tara Teknoy Branding Image -->
        <div class="mx-auto mb-6 max-w-[280px]">
            <img src="@Assets["images/logo_tarateknoy.png"]" class="block h-auto w-full" alt="Tara Teknoy Logo" />
        </div>

        <!-- Form Elements -->
        <div class="my-6">
            <input @bind="email" type="email" placeholder="University Email (.edu)"
                   class="w-full rounded-lg border-none bg-white px-4 py-3 text-base text-gray-800 placeholder-gray-400" />

            <input @bind="password" type="password" placeholder="Password"
                   class="mt-4 w-full rounded-lg border-none bg-white px-4 py-3 text-base text-gray-800 placeholder-gray-400" />

            <button @onclick="HandleLogin"
                    class="mt-4 w-full rounded-lg border-none bg-[#F7C631] px-4 py-3 text-lg font-bold text-[#801A1A] transition-colors hover:bg-[#e0b027]">
                Log in
            </button>
        </div>

        <!-- Optional Error Display -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mt-2 rounded bg-red-100 px-3 py-2 text-sm text-red-700">
                @errorMessage
            </div>
        }

        <!-- Bottom Link -->
        <div class="mt-6 text-sm text-gray-100">
            Don’t have an account?
            <a href="/signup" class="font-bold text-[#F7C631] no-underline hover:underline">Create an account</a>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string errorMessage = "";

    private void HandleLogin()
    {
        // SUCCESS: Navigates to the events page
        NavManager.NavigateTo("/events");
    }
}
